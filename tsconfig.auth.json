{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["server/auth", "server/wallet", "server/billing", "server/release", "functions/api/auth", "functions/api/wallet", "functions/api/billing"]
}
